{
  "manifest_version": 2,
  "id": "github.Chenhui-2.mai-tarot.plugin",
  "version": "1.0.0",
  "name": "塔罗牌占卜",
  "description": "塔罗牌占卜插件，支持单张抽牌和三张牌阵，支持AI解读，可配置指令与AI参数",
  "author": {
    "name": "Chenhui",
    "url": "https://github.com/Chenhui-2"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Chenhui-2/mai-tarot"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "game",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🔮"
    }
  },
  "capabilities": ["send.text", "send.image", "llm.generate"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
